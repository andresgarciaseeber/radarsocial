# ── Base de datos ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster.mongodb.net/radar_social

# ── Seguridad (generar con: openssl rand -hex 32) ─────────────────────────────
JWT_SECRET=cambiar_por_string_random_de_64_caracteres
TOKEN_ENCRYPTION_KEY=cambiar_por_string_random_de_32_caracteres

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://larioja.navegamisitio.com.ar
BACKEND_URL=https://radarsocial.navegamisitio.com.ar
PORT=3000

# ── Meta (Facebook + Instagram) ───────────────────────────────────────────────
META_APP_ID=tu_app_id_de_facebook
META_APP_SECRET=tu_app_secret_de_facebook
META_REDIRECT_URI=https://radarsocial.navegamisitio.com.ar/auth/meta/callback
# ID de la Login Configuration creada en el portal (reemplaza el scope explícito)
META_CONFIG_ID=922495744145952

# ── X / Twitter ───────────────────────────────────────────────────────────────
X_CLIENT_ID=tu_client_id_de_x
X_CLIENT_SECRET=tu_client_secret_de_x
X_BEARER_TOKEN=tu_bearer_token_de_x
X_REDIRECT_URI=https://radarsocial.navegamisitio.com.ar/auth/x/callback

# ── Análisis de sentimiento (opcional) ────────────────────────────────────────
# Si no se configura, el análisis de sentimiento queda deshabilitado
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Collector ─────────────────────────────────────────────────────────────────
# Formato cron: https://crontab.guru
# Default: cada 6 horas
COLLECTOR_CRON=0 */6 * * *
