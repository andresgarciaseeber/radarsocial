# --- Base de datos (XAMPP: dejar password vacío si no configuraste uno) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=radar_social
DB_USER=root
DB_PASSWORD=

# --- Auth ---
JWT_SECRET=cambiar_por_string_largo_aleatorio_min_32_chars
TOKEN_ENCRYPTION_KEY=clave_de_32_bytes_para_cifrar_tokens_oauth_00000

# --- URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
PORT=3000

# --- Meta (Facebook + Instagram) ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/auth/meta/callback

# --- X (Twitter) ---
X_API_KEY=           # Consumer Key        (OAuth 1.0a)
X_API_SECRET=        # Consumer Key Secret  (OAuth 1.0a)
X_BEARER_TOKEN=      # Access Token         (app-only, lectura pública)
X_CLIENT_ID=         # ID de Cliente        (OAuth 2.0, para conectar cuentas)
X_CLIENT_SECRET=     # Client Secret        (OAuth 2.0)
X_REDIRECT_URI=http://localhost:3000/auth/x/callback

# --- TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Recolector ---
COLLECTOR_CRON=0 */6 * * *
