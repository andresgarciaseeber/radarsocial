{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REEMPLAZAR-CON-URL-BACKEND.vercel.app/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://REEMPLAZAR-CON-URL-BACKEND.vercel.app/auth/:path*"
    },
    {
      "source": "/health",
      "destination": "https://REEMPLAZAR-CON-URL-BACKEND.vercel.app/health"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
